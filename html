* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "Poppins", sans-serif;
    color: #1f2937;
    background: #ffffff;
}

/* =========================
   NAVBAR
========================= */

header {
    width: 100%;
    background: white;
}

.navbar {
    max-width: 1200px;
    margin: auto;
    padding: 20px 30px;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    font-size: 25px;
    font-weight: 700;
    color: #2563eb;
}

.logo span {
    color: #10b981;
}

.nav-menu {
    list-style: none;
    display: flex;
    gap: 35px;
}

.nav-menu a {
    text-decoration: none;
    color: #4b5563;
    font-size: 14px;
    transition: 0.3s;
}

.nav-menu a:hover {
    color: #2563eb;
}

.btn-login {
    text-decoration: none;
    color: white;
    background: #2563eb;

    padding: 10px 22px;
    border-radius: 8px;

    font-size: 14px;
    transition: 0.3s;
}

.btn-login:hover {
    background: #1d4ed8;
}

/* =========================
   HERO
========================= */

.hero {
    max-width: 1200px;
    margin: auto;
    min-height: 600px;

    padding: 70px 30px;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 50px;
}

.hero-text {
    max-width: 600px;
}

.subtitle {
    color: #2563eb;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 2px;
    margin-bottom: 15px;
}

.hero h1 {
    font-size: 52px;
    line-height: 1.2;
    margin-bottom: 20px;
}

.hero h1 span {
    display: block;
    color: #2563eb;
}

.description {
    color: #6b7280;
    line-height: 1.8;
    margin-bottom: 30px;
}

.hero-buttons {
    display: flex;
    gap: 15px;
}

.btn-primary,
.btn-secondary {
    display: inline-block;
    text-decoration: none;

    padding: 13px 24px;
    border-radius: 8px;

    font-size: 14px;
    font-weight: 500;
}

.btn-primary {
    color: white;
    background: #2563eb;
}

.btn-primary:hover {
    background: #1d4ed8;
}

.btn-secondary {
    color: #2563eb;
    border: 1px solid #2563eb;
}

.btn-secondary:hover {
    background: #eff6ff;
}

/* Hero illustration */

.hero-image {
    width: 420px;
    height: 420px;

    position: relative;

    display: flex;
    align-items: center;
    justify-content: center;
}

.circle {
    width: 350px;
    height: 350px;

    background: #dbeafe;
    border-radius: 50%;

    position: absolute;
}

.book {
    position: absolute;
    font-size: 130px;
    z-index: 2;
}

.student {
    position: absolute;
    right: 20px;
    bottom: 30px;

    font-size: 90px;
    z-index: 3;
}

/* =========================
   STATS
========================= */

.stats {
    background: #2563eb;
    color: white;

    padding: 35px 10%;

    display: grid;
    grid-template-columns: repeat(4, 1fr);
    text-align: center;
}

.stat h2 {
    font-size: 30px;
}

.stat p {
    font-size: 13px;
    opacity: 0.8;
}

/* =========================
   MATERI
========================= */

.materi {
    max-width: 1200px;
    margin: auto;
    padding: 90px 30px;
}

.section-title {
    text-align: center;
    margin-bottom: 50px;
}

.section-title p {
    color: #2563eb;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2px;
}

.section-title h2 {
    font-size: 35px;
    margin: 10px 0;
}

.section-title span {
    color: #6b7280;
    font-size: 14px;
}

.card-container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.card {
    padding: 30px;
    border: 1px solid #e5e7eb;
    border-radius: 15px;

    transition: 0.3s;
}

.card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.08);
}

.icon {
    width: 60px;
    height: 60px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 12px;
    font-size: 28px;

    margin-bottom: 20px;
}

.blue {
    background: #dbeafe;
}

.green {
    background: #d1fae5;
}

.orange {
    background: #ffedd5;
}

.purple {
    background: #ede9fe;
}

.card h3 {
    margin-bottom: 10px;
}

.card p {
    color: #6b7280;
    font-size: 13px;
    line-height: 1.7;
    margin-bottom: 20px;
}

.card a {
    color: #2563eb;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
}

/* =========================
   ABOUT
========================= */

.about {
    background: #f8fafc;

    padding: 90px max(30px, calc((100% - 1140px) / 2));

    display: flex;
    align-items: center;
    gap: 80px;
}

.about-image {
    min-width: 400px;
    height: 350px;

    background: #dbeafe;
    border-radius: 25px;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 130px;
}

.about-text {
    max-width: 550px;
}

.about-text h2 {
    font-size: 35px;
    line-height: 1.3;
    margin-bottom: 20px;
}

.about-text > p:not(.subtitle) {
    color: #6b7280;
    line-height: 1.8;
    margin-bottom: 20px;
}

.check {
    margin-bottom: 25px;
}

.check p {
    margin: 8px 0;
    color: #374151;
    font-size: 14px;
}

/* =========================
   CTA
========================= */

.cta {
    text-align: center;

    background: linear-gradient(
        135deg,
        #2563eb,
        #4f46e5
    );

    color: white;
    padding: 80px 30px;
}

.cta h2 {
    font-size: 35px;
    margin-bottom: 10px;
}

.cta p {
    opacity: 0.85;
    margin-bottom: 30px;
}

.btn-white {
    display: inline-block;

    background: white;
    color: #2563eb;

    padding: 13px 28px;
    border-radius: 8px;

    text-decoration: none;
    font-weight: 600;
}

/* =========================
   FOOTER
========================= */

footer {
    background: #111827;
    color: white;
    padding: 60px 30px 20px;
}

.footer-content {
    max-width: 1100px;
    margin: auto;

    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 50px;
}

.footer-content p {
    color: #9ca3af;
    font-size: 13px;
    line-height: 1.8;
    margin-top: 10px;
}

.footer-content h3 {
    margin-bottom: 15px;
}

.footer-content a {
    display: block;
    color: #9ca3af;
    text-decoration: none;
    font-size: 13px;
    margin: 8px 0;
}

.footer-content a:hover {
    color: white;
}

.copyright {
    max-width: 1100px;
    margin: 40px auto 0;

    padding-top: 20px;
    border-top: 1px solid #374151;

    text-align: center;
    color: #6b7280;
    font-size: 12px;
}

/* =========================
   RESPONSIVE
========================= */

@media (max-width: 900px) {

    .nav-menu {
        display: none;
    }

    .hero {
        flex-direction: column;
        text-align: center;
    }

    .hero-buttons {
        justify-content: center;
    }

    .card-container {
        grid-template-columns: repeat(2, 1fr);
    }

    .stats {
        grid-template-columns: repeat(2, 1fr);
        gap: 30px;
    }

    .about {
        flex-direction: column;
        text-align: center;
    }

    .about-image {
        min-width: 100%;
    }

    .footer-content {
        grid-template-columns: 1fr 1fr;
    }
}

@media (max-width: 600px) {

    .hero h1 {
        font-size: 38px;
    }

    .hero-image {
        width: 300px;
        height: 300px;
    }

    .circle {
        width: 250px;
        height: 250px;
    }

    .book {
        font-size: 90px;
    }

    .student {
        font-size: 60px;
    }

    .stats {
        grid-template-columns: 1fr 1fr;
    }

    .card-container {
        grid-template-columns: 1fr;
    }

    .about-text h2 {
        font-size: 28px;
    }

    .footer-content {
        grid-template-columns: 1fr;
    }
}